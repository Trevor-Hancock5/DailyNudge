                     <children>
                        <Button mnemonicParsing="false" text="Backup" />
                        <Button mnemonicParsing="false" text="Export" />
                        <Button mnemonicParsing="false" text="Import" />
                     </children>
                  </HBox>
                  <Button mnemonicParsing="false" text="Reset All Data" />
                  <Button mnemonicParsing="false" text="View All Habits" />
               </children>
            </VBox>
         </content>
      </Tab>
      <Tab text="About">
         <content>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="Name: Bob?" />
                  <ImageView fx:id="imageView" fitHeight="150.0" fitWidth="150.0" pickOnBounds="true">
                     <image>
                        <Image url="@../../data/defaultAvatar.jpg" />
                     </image>
                  </ImageView>
                  <Label text="Age: Old?" />
                  <Button mnemonicParsing="false" text="About Me" />
                  <Label text="Version: " />

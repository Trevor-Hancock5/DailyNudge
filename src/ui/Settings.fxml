                        <ToggleButton mnemonicParsing="false" text="Flexible Streak" />
                        <ToggleButton mnemonicParsing="false" text="Normal Streak" />
                     </children>
                  </HBox>
                  <Button mnemonicParsing="false" text="Feedback/Report Bug" />
               </children>
            </VBox>
         </content>
    </Tab>
    <Tab text="Appearance">
         <content>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="Select Mode">
                     <padding>
                        <Insets left="15.0" top="10.0" />
                     </padding>
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <HBox prefHeight="45.0" prefWidth="200.0">
                     <padding>
                        <Insets left="15.0" top="15.0" />
                     </padding>
                     <children>
                        <ToggleButton mnemonicParsing="false" style="-fx-background-color: white; -fx-text-fill: black;" text="Light Mode" />
                        <ToggleButton mnemonicParsing="false" style="-fx-background-color: black; -fx-text-fill: white;" text="Dark Mode" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
    </Tab>
      <Tab text="Data">
         <content>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Button mnemonicParsing="false" text="Save" />
